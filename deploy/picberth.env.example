# PicBerth configuration for a native install.
# Copy to /etc/picberth/picberth.env with mode 0600, owner root:root. systemd reads this
# file as root, so the picberth user does not need access to it.
# Format: KEY=value, one per line. Lines starting with # are comments.
# Each key is shown commented out with its default. Uncomment only what you change.

# Address the HTTP server listens on. Keep loopback when a reverse proxy runs on this host.
# PICBERTH_LISTEN=127.0.0.1:12433

# Data directory for the database, images, trash and cache. Defaults:
# Linux ~/.local/share/picberth, macOS ~/Library/Application Support/PicBerth, Windows %LOCALAPPDATA%\PicBerth.
# The systemd unit already sets /var/lib/picberth; changing it here must match ReadWritePaths.
# PICBERTH_DATA_DIR=

# Public base URL used in links and cookie security. Set it to your https URL. Unset logs a warning.
# Default: http://<listen>
# PICBERTH_PUBLIC_URL=http://127.0.0.1:12433

# Base URL for image links. Set it only when images are served from a different origin.
# Default: same as PICBERTH_PUBLIC_URL
# PICBERTH_IMAGE_URL=

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Default: empty (trust no proxy)
# PICBERTH_TRUSTED_PROXIES=

# Hard upload size limit in bytes. 104857600 is 100 MiB.
# PICBERTH_HARD_MAX_UPLOAD=104857600

# Directory for snapshots created by "picberth snapshot".
# Default: <data>/snapshots
# PICBERTH_SNAPSHOT_DIR=

# Log level: debug, info, warn or error.
# PICBERTH_LOG_LEVEL=info

# Log format: text or json.
# PICBERTH_LOG_FORMAT=text

# Development only: serve the SPA from this directory instead of the embedded build.
# Default: empty (serve the embedded SPA)
# PICBERTH_DEV_WEB_DIR=

# Optional path to a file of KEY=value lines in this same format.
# Default: none
# PICBERTH_CONFIG=
