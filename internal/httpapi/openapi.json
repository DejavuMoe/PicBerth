{
  "openapi": "3.1.0",
  "info": {
    "title": "PicBerth API",
    "version": "1.0.0",
    "description": "JSON API of the PicBerth single-user image host. All endpoints live under /api/v1. Errors are RFC 9457 problem documents with a stable `code`. Session-authenticated unsafe requests must send `X-PicBerth-Client: web`; token-authenticated requests need no extra header.",
    "license": { "name": "Proprietary" }
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
  "tags": [
    { "name": "session" },
    { "name": "images" },
    { "name": "folders" },
    { "name": "tokens" },
    { "name": "operations" }
  ],
  "paths": {
    "/api/v1/session": {
      "get": {
        "tags": ["session"],
        "summary": "Current session state",
        "security": [{}, { "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["authenticated", "setupRequired", "user", "limits", "version"],
                  "properties": {
                    "authenticated": { "type": "boolean" },
                    "setupRequired": { "type": "boolean" },
                    "user": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }] },
                    "limits": {
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "required": ["maxUploadBytes", "allowedFormats"],
                          "properties": {
                            "maxUploadBytes": { "type": "integer", "minimum": 1024 },
                            "allowedFormats": { "type": "array", "items": { "$ref": "#/components/schemas/Format" } }
                          }
                        }
                      ]
                    },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["session"],
        "summary": "Sign in",
        "security": [{}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "additionalProperties": false,
                "properties": {
                  "username": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
                  "password": { "type": "string", "minLength": 10, "maxLength": 256 }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Session cookie issued" },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "delete": {
        "tags": ["session"],
        "summary": "Sign out",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "204": { "description": "Session ended; the cookie is cleared" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": ["session"],
        "summary": "Create the first administrator",
        "security": [{}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["setupCode", "username", "password"],
                "additionalProperties": false,
                "properties": {
                  "setupCode": { "type": "string" },
                  "username": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "password": { "type": "string", "minLength": 10, "maxLength": 256 }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Administrator created; session cookie issued" },
          "400": { "$ref": "#/components/responses/Validation" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "description": "setup-required or setup-done", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/images": {
      "get": {
        "tags": ["images"],
        "summary": "List images",
        "description": "Upload-only tokens see only the images they uploaded, whatever the filters say.",
        "parameters": [
          { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["active", "trashed"], "default": "active" } },
          { "name": "folder", "in": "query", "description": "`root` or a folder id. Browsing lists direct children only; add recursive=true for the whole subtree.", "schema": { "type": "string" } },
          { "name": "recursive", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "q", "in": "query", "description": "Substring of the filename (case-insensitive), exact id, or sha256 prefix (at least 8 hex characters).", "schema": { "type": "string", "maxLength": 200 } },
          { "name": "format", "in": "query", "description": "Repeatable or comma-separated; any of.", "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Format" } }, "style": "form", "explode": true },
          { "name": "source", "in": "query", "description": "Repeatable; any of web, cli, token:<id>.", "schema": { "type": "array", "items": { "type": "string", "pattern": "^(web|cli|token:[0-9]+)$" } }, "style": "form", "explode": true },
          { "name": "tokenId", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "since", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "until", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["new", "old", "large", "small", "name"], "default": "new" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 60 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "A page of images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "nextCursor"],
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/Image" } },
                    "nextCursor": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["images"],
        "summary": "Upload an image",
        "description": "multipart/form-data with exactly one `file` part and optional `folder`. At most 8 parts. An unknown or foreign folder is 404; folders are never auto-created. Deduplication is scoped to the destination folder (the root counts as one), across the owner's visible library, or to the token's own uploads for an upload-only token.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "folder": { "type": "string", "description": "Destination folder id; omitted or empty means the root." }
                }
              },
              "encoding": {
                "file": { "contentType": "application/octet-stream" },
                "folder": { "contentType": "text/plain" }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; Location header points at the image",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Image" } } }
          },
          "200": {
            "description": "An identical image already exists in the folder (duplicate=true); nothing new was stored",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Image" } } }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedFormat" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "507": { "$ref": "#/components/responses/InsufficientStorage" }
        }
      }
    },
    "/api/v1/images/facets": {
      "get": {
        "tags": ["images"],
        "summary": "Counts over the visible set",
        "parameters": [
          { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["active", "trashed"], "default": "active" } }
        ],
        "responses": {
          "200": {
            "description": "Facets",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Facets" } } }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/images/batch": {
      "post": {
        "tags": ["images"],
        "summary": "Apply one action to up to 500 images",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "ids"],
                "additionalProperties": false,
                "properties": {
                  "action": { "type": "string", "enum": ["trash", "restore", "purge", "move"] },
                  "ids": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "string" } },
                  "folderId": { "type": ["string", "null"], "description": "Destination for action=move; null or absent means the root." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-image results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["results"],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "ok"],
                        "properties": {
                          "id": { "type": "string" },
                          "ok": { "type": "boolean" },
                          "code": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/images/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ImageID" }],
      "get": {
        "tags": ["images"],
        "summary": "Get one image",
        "responses": {
          "200": { "description": "Image", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Image" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["images"],
        "summary": "Rename or move an image",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "filename": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "folderId": { "type": ["string", "null"], "description": "New folder; null moves to the root. An unknown folder is 404." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated image", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Image" } } } },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["images"],
        "summary": "Move an image to the trash",
        "responses": {
          "204": { "description": "Trashed (idempotent)" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/images/{id}/restore": {
      "parameters": [{ "$ref": "#/components/parameters/ImageID" }],
      "post": {
        "tags": ["images"],
        "summary": "Restore an image from the trash",
        "responses": {
          "200": { "description": "Restored image", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Image" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/images/{id}/purge": {
      "parameters": [{ "$ref": "#/components/parameters/ImageID" }],
      "post": {
        "tags": ["images"],
        "summary": "Permanently delete a trashed image",
        "responses": {
          "204": { "description": "Purged; the id becomes a tombstone" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/images/{id}/raw": {
      "parameters": [{ "$ref": "#/components/parameters/ImageID" }],
      "get": {
        "tags": ["images"],
        "summary": "Original bytes (authenticated)",
        "responses": {
          "200": { "description": "Image bytes", "content": { "image/*": { "schema": { "type": "string", "format": "binary" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/images/{id}/thumb": {
      "parameters": [{ "$ref": "#/components/parameters/ImageID" }],
      "get": {
        "tags": ["images"],
        "summary": "Thumbnail (authenticated)",
        "responses": {
          "200": { "description": "Thumbnail bytes", "content": { "image/jpeg": { "schema": { "type": "string", "format": "binary" } }, "image/png": { "schema": { "type": "string", "format": "binary" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/folders": {
      "get": {
        "tags": ["folders"],
        "summary": "List every folder (flat)",
        "description": "Any authenticated principal of the owner may list, including upload-only tokens.",
        "responses": {
          "200": {
            "description": "Folders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Folder" } } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["folders"],
        "summary": "Create a folder",
        "description": "Session or manage token only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "parentId": { "type": ["string", "null"], "description": "Parent folder; null creates a root folder." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created folder", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Folder" } } } },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/FolderExists" },
          "422": { "$ref": "#/components/responses/FolderDepth" }
        }
      }
    },
    "/api/v1/folders/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/FolderID" }],
      "patch": {
        "tags": ["folders"],
        "summary": "Rename or move a folder",
        "description": "Moving checks the depth of the whole subtree and rejects cycles. Session or manage token only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "parentId": { "type": ["string", "null"], "description": "New parent; null moves the folder to the root." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated folder", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Folder" } } } },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/FolderExists" },
          "422": { "$ref": "#/components/responses/FolderDepth" }
        }
      },
      "delete": {
        "tags": ["folders"],
        "summary": "Delete an empty folder",
        "description": "Only folders without subfolders and without active images can be deleted. Trashed images in the folder return to the root. Session or manage token only.",
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/FolderNotEmpty" }
        }
      }
    },
    "/api/v1/tokens": {
      "get": {
        "tags": ["tokens"],
        "summary": "List tokens (session only)",
        "responses": {
          "200": {
            "description": "Tokens, newest first; revoked included",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Token" } } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["tokens"],
        "summary": "Create a token (session only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "scopes"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "scopes": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["upload", "manage"] } },
                  "expiresInDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The secret is shown exactly once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["token", "secret"],
                  "properties": {
                    "token": { "$ref": "#/components/schemas/Token" },
                    "secret": { "type": "string", "pattern": "^pb_[0-9a-z]{32}$" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/InvalidScope" }
        }
      }
    },
    "/api/v1/tokens/{id}": {
      "delete": {
        "tags": ["tokens"],
        "summary": "Revoke a token (session only)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "204": { "description": "Revoked (idempotent)" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": ["operations"],
        "summary": "Read settings (session only)",
        "responses": {
          "200": { "description": "Settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Settings" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "patch": {
        "tags": ["operations"],
        "summary": "Update settings (session only)",
        "description": "Removed keys are unknown fields and answer 400. The read-only infrastructure fields may be echoed back unchanged.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingsPatch" } } }
        },
        "responses": {
          "200": { "description": "Updated settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Settings" } } } },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": ["operations"],
        "summary": "Instance status (session only)",
        "responses": {
          "200": { "description": "Status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/checks": {
      "post": {
        "tags": ["operations"],
        "summary": "Run a consistency check (session only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mode"],
                "additionalProperties": false,
                "properties": { "mode": { "type": "string", "enum": ["quick", "full"] } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Check report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckReport" } } } },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/snapshots": {
      "post": {
        "tags": ["operations"],
        "summary": "Take a snapshot (session only)",
        "responses": {
          "201": { "description": "Snapshot written", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "tags": ["operations"],
        "summary": "Read the audit log (session only)",
        "parameters": [
          { "name": "action", "in": "query", "description": "Exact action string, e.g. image.trash.", "schema": { "type": "string" } },
          { "name": "kind", "in": "query", "description": "Action category: image.*, folder.*, token.*, settings.*; system = check.*, admin.*, snapshot; session = login.*, logout, setup, setup.failure.", "schema": { "type": "string", "enum": ["image", "folder", "token", "settings", "system", "session"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of entries, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "nextCursor"],
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEntry" } },
                    "nextCursor": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/audit/actions": {
      "get": {
        "tags": ["operations"],
        "summary": "Distinct audit action strings (session only)",
        "responses": {
          "200": {
            "description": "Actions, ascending",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": { "items": { "type": "array", "items": { "type": "string" } } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": ["operations"],
        "summary": "This document",
        "security": [{}],
        "responses": { "200": { "description": "OpenAPI 3.1 document", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "`Authorization: Bearer pb_…`. Never in the query string." },
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "__Host-pb_session", "description": "Browser session cookie (named pb_session on plain HTTP). Unsafe requests must also send X-PicBerth-Client: web." }
    },
    "parameters": {
      "ImageID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{20}$" } },
      "FolderID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{16}$" } }
    },
    "responses": {
      "Validation": { "description": "Malformed request or bad field", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Unauthorized": { "description": "Missing or invalid credentials", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Forbidden": { "description": "Not allowed", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "NotFound": { "description": "Does not exist or is not visible", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Conflict": { "description": "State does not allow the action", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "FolderExists": { "description": "A sibling folder already uses the name (folder-exists)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "FolderNotEmpty": { "description": "The folder contains images or subfolders (folder-not-empty)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "FolderDepth": { "description": "More than 3 levels (folder-depth)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "InvalidScope": { "description": "An unknown or removed token scope, e.g. read (invalid-scope)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "TooLarge": { "description": "Upload exceeds the size limit", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "UnsupportedFormat": { "description": "Not an allowed image format", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Unprocessable": { "description": "Invalid image or too many pixels", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "RateLimited": { "description": "Too many requests; Retry-After in seconds", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "InsufficientStorage": { "description": "Free disk space below the watermark", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "Format": { "type": "string", "enum": ["jpeg", "png", "gif", "webp", "avif"] },
      "Image": {
        "type": "object",
        "required": ["id", "url", "filename", "folderId", "mime", "ext", "size", "width", "height", "frames", "sha256", "state", "hasGps", "hasThumb", "broken", "duplicate", "source", "createdAt", "trashedAt", "links"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{20}$" },
          "url": { "type": "string", "description": "Public image URL; every active image is public." },
          "filename": { "type": "string" },
          "folderId": { "type": ["string", "null"] },
          "mime": { "type": "string" },
          "ext": { "type": "string" },
          "size": { "type": "integer" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "frames": { "type": "integer", "description": "Greater than 1 means animated." },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "state": { "type": "string", "enum": ["active", "trashed"] },
          "hasGps": { "type": "boolean" },
          "hasThumb": { "type": "boolean" },
          "broken": { "type": "boolean" },
          "duplicate": { "type": "boolean", "description": "Only meaningful in upload responses." },
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["web", "token", "cli"] },
              "tokenId": { "type": "integer" },
              "tokenName": { "type": "string" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "trashedAt": { "type": ["string", "null"], "format": "date-time" },
          "links": {
            "type": "object",
            "required": ["url", "markdown", "html", "bbcode"],
            "properties": {
              "url": { "type": "string" },
              "markdown": { "type": "string" },
              "html": { "type": "string" },
              "bbcode": { "type": "string" }
            }
          }
        }
      },
      "Folder": {
        "type": "object",
        "required": ["id", "name", "parentId", "depth", "imageCount", "createdAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{16}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "parentId": { "type": ["string", "null"] },
          "depth": { "type": "integer", "minimum": 1, "maximum": 3 },
          "imageCount": { "type": "integer", "description": "Active images directly in the folder." },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Facets": {
        "type": "object",
        "required": ["total", "bytes", "formats", "sources"],
        "properties": {
          "total": { "type": "integer" },
          "bytes": { "type": "integer" },
          "formats": {
            "type": "object",
            "required": ["jpeg", "png", "gif", "webp", "avif"],
            "additionalProperties": { "type": "integer" }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "kind", "count"],
              "properties": {
                "key": { "type": "string" },
                "kind": { "type": "string", "enum": ["web", "token", "cli"] },
                "tokenId": { "type": "integer" },
                "tokenName": { "type": "string" },
                "count": { "type": "integer" }
              }
            }
          }
        }
      },
      "Token": {
        "type": "object",
        "required": ["id", "name", "prefix", "scopes", "createdAt", "expiresAt", "lastUsedAt", "revokedAt"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "prefix": { "type": "string" },
          "scopes": { "type": "array", "items": { "type": "string", "enum": ["upload", "manage"] } },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "lastUsedAt": { "type": ["string", "null"], "format": "date-time" },
          "revokedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Settings": {
        "type": "object",
        "required": ["maxUploadBytes", "allowedFormats", "dedupe", "trashRetentionDays", "auditRetentionDays", "publicUrl", "imageUrl", "hardMaxUploadBytes"],
        "properties": {
          "maxUploadBytes": { "type": "integer", "minimum": 1024 },
          "allowedFormats": { "type": "array", "items": { "$ref": "#/components/schemas/Format" } },
          "dedupe": { "type": "boolean" },
          "trashRetentionDays": { "type": "integer", "minimum": 0, "maximum": 365 },
          "auditRetentionDays": { "type": "integer", "minimum": 7, "maximum": 3650 },
          "publicUrl": { "type": "string", "readOnly": true },
          "imageUrl": { "type": "string", "readOnly": true },
          "hardMaxUploadBytes": { "type": "integer", "readOnly": true }
        }
      },
      "SettingsPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxUploadBytes": { "type": "integer", "minimum": 1024 },
          "allowedFormats": { "type": "array", "items": { "$ref": "#/components/schemas/Format" } },
          "dedupe": { "type": "boolean" },
          "trashRetentionDays": { "type": "integer", "minimum": 0, "maximum": 365 },
          "auditRetentionDays": { "type": "integer", "minimum": 7, "maximum": 3650 },
          "publicUrl": { "type": "string", "readOnly": true },
          "imageUrl": { "type": "string", "readOnly": true },
          "hardMaxUploadBytes": { "type": "integer", "readOnly": true }
        }
      },
      "Status": {
        "type": "object",
        "required": ["version", "commit", "goVersion", "sqliteVersion", "startedAt", "uptimeSeconds", "images", "database", "disk", "dataDir", "lastSnapshot", "lastCheck", "warnings"],
        "properties": {
          "version": { "type": "string" },
          "commit": { "type": "string" },
          "goVersion": { "type": "string" },
          "sqliteVersion": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time" },
          "uptimeSeconds": { "type": "integer" },
          "images": {
            "type": "object",
            "required": ["active", "trashed", "bytes", "broken"],
            "properties": {
              "active": { "type": "integer" },
              "trashed": { "type": "integer" },
              "bytes": { "type": "integer" },
              "broken": { "type": "integer" }
            }
          },
          "database": {
            "type": "object",
            "required": ["bytes", "walBytes"],
            "properties": { "bytes": { "type": "integer" }, "walBytes": { "type": "integer" } }
          },
          "disk": {
            "type": "object",
            "required": ["freeBytes", "totalBytes", "watermarkBytes"],
            "properties": { "freeBytes": { "type": "integer" }, "totalBytes": { "type": "integer" }, "watermarkBytes": { "type": "integer" } }
          },
          "dataDir": { "type": "string" },
          "lastSnapshot": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["at", "path"],
                "properties": { "at": { "type": "string", "format": "date-time" }, "path": { "type": "string" } }
              }
            ]
          },
          "lastCheck": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["at", "mode", "ok", "issues"],
                "properties": {
                  "at": { "type": "string", "format": "date-time" },
                  "mode": { "type": "string", "enum": ["quick", "full"] },
                  "ok": { "type": "boolean" },
                  "issues": { "type": "integer" }
                }
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
            }
          }
        }
      },
      "CheckReport": {
        "type": "object",
        "required": ["mode", "startedAt", "durationMs", "ok", "checked", "issues"],
        "properties": {
          "mode": { "type": "string", "enum": ["quick", "full"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "integer" },
          "ok": { "type": "boolean" },
          "checked": { "type": "integer" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "imageId", "path", "repaired"],
              "properties": {
                "kind": { "type": "string", "enum": ["missing-file", "size-mismatch", "hash-mismatch", "orphan-file", "pending-move", "stale-temp"] },
                "imageId": { "type": ["string", "null"] },
                "path": { "type": ["string", "null"] },
                "repaired": { "type": "boolean" }
              }
            }
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": ["path", "images", "bytes", "createdAt"],
        "properties": {
          "path": { "type": "string" },
          "images": { "type": "integer" },
          "bytes": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": ["id", "at", "actor", "action", "target", "detail", "ip"],
        "properties": {
          "id": { "type": "integer" },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" },
          "detail": { "type": "string" },
          "ip": { "type": "string" }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string", "pattern": "^urn:picberth:problem:" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "code": {
            "type": "string",
            "enum": ["validation", "unauthorized", "forbidden", "not-found", "conflict", "folder-exists", "folder-not-empty", "folder-depth", "invalid-scope", "too-large", "unsupported-format", "invalid-image", "too-many-pixels", "setup-required", "setup-done", "rate-limited", "insufficient-storage", "internal"]
          }
        }
      }
    }
  }
}
